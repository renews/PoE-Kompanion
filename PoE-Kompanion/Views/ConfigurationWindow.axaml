<Window 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:PoEKompanion.Controls"
    xmlns:views="clr-namespace:PoEKompanion.Views"
    mc:Ignorable="d"
    x:Class="PoEKompanion.Views.ConfigurationWindow"
    x:DataType="views:ConfigurationWindow"
    Title="PoE Kompanion Configuration"
    CanResize="False"
    SystemDecorations="None"
    ShowInTaskbar="True"
    Topmost="True"
    Width="400"
    SizeToContent="Height"
>

    <Window.Styles>
        <StyleInclude Source="/Styles/PoETheme.axaml"/>
    </Window.Styles>

    <Border Background="{StaticResource PoEPanelBackgroundBrush}"
            BorderBrush="{StaticResource PoEBorderLightBrush}"
            BorderThickness="2"
            Padding="20">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="HOTKEYS"
                       Classes="PoEHeading"
                       HorizontalAlignment="Left"
                       Margin="10,0,0,15" />
            <Grid DockPanel.Dock="Bottom"
                  ColumnDefinitions="*,*"
                  HorizontalAlignment="Stretch"
                  Margin="0,10,0,0">
                <Button Grid.Column="0"
                        Content="SAVE"
                        Click="OnSaveClick"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,5,0"
                        Height="35">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!#LogoutHotkeyPicker.IsListening" />
                            <Binding Path="!#SettingsHotkeyPicker.IsListening" />
                            <Binding Path="!#ExitHotkeyPicker.IsListening" />
                            <Binding Path="!#ChatCommand1HotkeyPicker.IsListening" />
                            <Binding Path="!#ChatCommand2HotkeyPicker.IsListening" />
                            <Binding Path="!#ChatCommand3HotkeyPicker.IsListening" />
                            <Binding Path="!#ChatCommand4HotkeyPicker.IsListening" />
                            <Binding Path="!#ChatCommand5HotkeyPicker.IsListening" />
                            <Binding Path="!#AutoWeaponSwapKeyPicker.IsListening" />
                            <Binding Path="!#AutoWeaponSwapToggleHotkeyPicker.IsListening" />
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
                <Button Grid.Column="1"
                        Click="OnCancelClick"
                        Content="CLOSE"
                        IsCancel="True"
                        HorizontalAlignment="Stretch"
                        Margin="5,0,0,0"
                        Height="35">
                    <Button.IsEnabled>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!#LogoutHotkeyPicker.IsListening" />
                            <Binding Path="!#SettingsHotkeyPicker.IsListening" />
                            <Binding Path="!#ExitHotkeyPicker.IsListening" />
                            <Binding Path="!#ChatCommand1HotkeyPicker.IsListening" />
                            <Binding Path="!#ChatCommand2HotkeyPicker.IsListening" />
                            <Binding Path="!#ChatCommand3HotkeyPicker.IsListening" />
                            <Binding Path="!#ChatCommand4HotkeyPicker.IsListening" />
                            <Binding Path="!#ChatCommand5HotkeyPicker.IsListening" />
                            <Binding Path="!#AutoWeaponSwapKeyPicker.IsListening" />
                            <Binding Path="!#AutoWeaponSwapToggleHotkeyPicker.IsListening" />
                        </MultiBinding>
                    </Button.IsEnabled>
                </Button>
            </Grid>

            <Grid ColumnDefinitions="200,150" ColumnSpacing="6"
                  RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="10"
                  Margin="0 10 0 20">
                <Label Grid.Column="0" Grid.Row="0" Content="Logout:" />
                <controls:HotkeyPickerButton
                    Name="LogoutHotkeyPicker"
                    Grid.Column="1" Grid.Row="0"
                    SelectedHotkey="{Binding LogoutHotkey}" />

                <Label Grid.Column="0" Grid.Row="1" Content="Open Settings:" />
                <controls:HotkeyPickerButton
                    Name="SettingsHotkeyPicker"
                    Grid.Column="1" Grid.Row="1"
                    SelectedHotkey="{Binding OpenSettingsHotkey}" />

                <Label Grid.Column="0" Grid.Row="2" Content="Exit:" />
                <controls:HotkeyPickerButton
                    Name="ExitHotkeyPicker"
                    Grid.Column="1" Grid.Row="2"
                    SelectedHotkey="{Binding ExitHotkey}" />

                <Label Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Content="Custom Commands:" Margin="0,10,0,0" />

                <TextBlock Grid.Column="0" Grid.Row="4" Text="Command" Classes="PoEHeading" />
                <TextBlock Grid.Column="1" Grid.Row="4" Text="Shortcut" Classes="PoEHeading" />

                <TextBox
                    Grid.Column="0" Grid.Row="5"
                    MinWidth="190"
                    Text="{Binding ChatCommand1Command, UpdateSourceTrigger=PropertyChanged}"
                    Watermark="/played" />
                <controls:HotkeyPickerButton
                    Name="ChatCommand1HotkeyPicker"
                    Grid.Column="1" Grid.Row="5"
                    SelectedHotkey="{Binding ChatCommand1Hotkey}" />

                <TextBox
                    Grid.Column="0" Grid.Row="6"
                    MinWidth="190"
                    Text="{Binding ChatCommand2Command, UpdateSourceTrigger=PropertyChanged}"
                    Watermark="/remaining" />
                <controls:HotkeyPickerButton
                    Name="ChatCommand2HotkeyPicker"
                    Grid.Column="1" Grid.Row="6"
                    SelectedHotkey="{Binding ChatCommand2Hotkey}" />

                <TextBox
                    Grid.Column="0" Grid.Row="7"
                    MinWidth="190"
                    Text="{Binding ChatCommand3Command, UpdateSourceTrigger=PropertyChanged}"
                    Watermark="/deaths" />
                <controls:HotkeyPickerButton
                    Name="ChatCommand3HotkeyPicker"
                    Grid.Column="1" Grid.Row="7"
                    SelectedHotkey="{Binding ChatCommand3Hotkey}" />

                <TextBox
                    Grid.Column="0" Grid.Row="8"
                    MinWidth="190"
                    Text="{Binding ChatCommand4Command, UpdateSourceTrigger=PropertyChanged}"
                    Watermark="/hideout" />
                <controls:HotkeyPickerButton
                    Name="ChatCommand4HotkeyPicker"
                    Grid.Column="1" Grid.Row="8"
                    SelectedHotkey="{Binding ChatCommand4Hotkey}" />

                <TextBox
                    Grid.Column="0" Grid.Row="9"
                    MinWidth="190"
                    Text="{Binding ChatCommand5Command, UpdateSourceTrigger=PropertyChanged}"
                    Watermark="/leave" />
                <controls:HotkeyPickerButton
                    Name="ChatCommand5HotkeyPicker"
                    Grid.Column="1" Grid.Row="9"
                    SelectedHotkey="{Binding ChatCommand5Hotkey}" />

                <Label Grid.Column="0" Grid.Row="10" Grid.ColumnSpan="2" Content="Auto Weapon Swap:" Margin="0,10,0,0" />

                <Label Grid.Column="0" Grid.Row="11" Content="Toggle:" />
                <controls:HotkeyPickerButton
                    Name="AutoWeaponSwapToggleHotkeyPicker"
                    Grid.Column="1" Grid.Row="11"
                    SelectedHotkey="{Binding AutoWeaponSwapToggleHotkey}" />

                <Label Grid.Column="0" Grid.Row="12" Content="Key:" />
                <controls:HotkeyPickerButton
                    Name="AutoWeaponSwapKeyPicker"
                    Grid.Column="1" Grid.Row="12"
                    SelectedHotkey="{Binding AutoWeaponSwapKey}" />

                <Label Grid.Column="0" Grid.Row="13" Content="{Binding AutoWeaponSwapIntervalLabel}" />
                <Slider
                    Grid.Column="1" Grid.Row="13"
                    Minimum="300"
                    Maximum="1000"
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    Value="{Binding AutoWeaponSwapIntervalMs, Mode=TwoWay}" />
            </Grid>

        </DockPanel>
    </Border>
</Window>
